		"live": "bun run scripts/live-check.ts"
	},
	"devDependencies": {
		"@fastly/cli": "^16.1.0",
		"@fastly/js-compute": "^3.46.0",
		"typescript": "^5.6.0"
	},
	"overrides": {
		"@bytecodealliance/weval": "^0.5.0"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	}
}
