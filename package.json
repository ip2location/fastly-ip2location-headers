{
	"name": "fastly-ip2location-headers",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "Fastly Compute service that enriches origin requests with IP2Location.io fields Fastly's own client geolocation does not provide.",
	"scripts": {
