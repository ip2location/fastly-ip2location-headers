{
	"compilerOptions": {
		"target": "ES2022",
		/* Fastly supplies the web-platform globals, so WebWorker describes them. */
		"lib": ["ES2022", "WebWorker"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		/* Imports carry .ts extensions; the bundler resolves them literally. */
		"allowImportingTsExtensions": true,
		/* Structural types instead of @fastly/js-compute. See src/modules.d.ts. */
		"types": [],
		"strict": true,
		"noUncheckedIndexedAccess": false,
		"noImplicitOverride": true,
		"noEmit": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["lib/**/*.ts", "src/**/*.ts"]
}
